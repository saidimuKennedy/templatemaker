generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id
  email      String      @unique
  password   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  sessions   Session[]
  portfolios Portfolio[]
  assets     Asset[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Portfolio {
  id         String          @id
  userId     String
  title      String
  templateId String          @default("executive")
  slug       String?         @unique
  status     PortfolioStatus @default(DRAFT)
  content    Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model Asset {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  providerId   String
  url          String
  width        Int      @default(0)
  height       Int      @default(0)
  byteSize     Int      @default(0)
  contentType  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([provider, providerId])
}
